# Application
PROJECT_NAME="Nutrino"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="nutrino"
POSTGRES_PASSWORD="nutrino_password"
POSTGRES_DB="nutrino_db"
# Optional direct URI override (if not specified, assembled from the above fields)
# DATABASE_URL="postgresql+psycopg2://nutrino:nutrino_password@localhost:5432/nutrino_db"

# Security & Authentication (JWT)
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_SECONDS=120.0


# CORS
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]'
