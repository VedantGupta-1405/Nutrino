# ==============================================================================
# Nutrino - Production Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Settings
PROJECT_NAME="Nutrino"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG="false"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="nutrino"
POSTGRES_PASSWORD="replace_with_a_secure_database_password"
POSTGRES_DB="nutrino_db"
# Optional direct database connection string (if specified, takes precedence):
# DATABASE_URL="postgresql+psycopg2://nutrino:replace_with_a_secure_database_password@postgres:5432/nutrino_db"

# Security & Authentication (JWT)
# Generate a secure 32+ character key: openssl rand -hex 32
JWT_SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_minimum_32_chars"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_minimum_32_chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Ollama Configuration
# In Docker Compose, host.docker.internal reaches the host machine's Ollama instance
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_SECONDS=180.0

# CORS Configuration
# Comma-separated list or JSON array of allowed origins for web clients
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost"]'
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost"]'

# Port Mapping (Optional host port overrides for Docker Compose)
FRONTEND_PORT=3000
BACKEND_PORT=8000
